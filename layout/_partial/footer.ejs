<footer class="footer">
    <ul class="list-inline text-center">
        <% if (config.twitter_username) { %>
        <li>
            <a target="_blank" href="https://twitter.com/<%= config.twitter_username %>" aria-label="Twitter">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-twitter"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.zhihu_username) { %>
        <li>
            <a target="_blank" href="https://www.zhihu.com/people/<%= config.zhihu_username %>" aria-label="知乎">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-zhihu"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.weibo_username) { %>
        <li>
            <a target="_blank" href="https://weibo.com/<%= config.weibo_username %>" aria-label="微博">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-weibo"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.facebook_username) { %>
        <li>
            <a target="_blank" href="https://www.facebook.com/<%= config.facebook_username %>" aria-label="Facebook">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-facebook"></i>
                </span>
            </a>
        </li>
        <% } %>

        <% if (config.linkedin_username) { %>
        <li>
            <a target="_blank" href="https://www.linkedin.com/in/<%= config.linkedin_username %>" aria-label="LinkedIn">
                <span class="fa-stack fa-lg">
                    <i class="iconfont icon-linkedin"></i>
                </span>
            </a>
        </li>
        <% } %>

    </ul>

    <% if(config.friends) { %>
    <div class="footer-friends">
        <span class="footer-section-title">友情链接</span>
        <span class="footer-friends-links">
            <% config.friends.forEach(function(friend, idx){ %>
                <a href="<%= friend.href %>" target="_blank" rel="friend"><%= friend.title %></a><% if(idx < config.friends.length - 1){ %><span class="footer-friends-sep">·</span><% } %>
            <% }); %>
        </span>
    </div>
    <% }%>

    <div class="footer-bottom">
        <span class="footer-stats">
            <span class="footer-stat" title="总访问量">
                <span class="footer-stat-value" id="busuanzi_value_site_pv"></span>
                <span class="footer-stat-label">次访问</span>
            </span>
            <span class="footer-stat-divider"></span>
            <span class="footer-stat" title="访客数">
                <span class="footer-stat-value" id="busuanzi_value_site_uv"></span>
                <span class="footer-stat-label">位访客</span>
            </span>
        </span>
        <span class="footer-copyright">
            由 <a href="https://hexo.io/">Hexo</a> 强力驱动 · 主题 <a href="https://github.com/wu3227834/hexo-theme-aerlume">Aerlume</a>
        </span>
    </div>
</footer>

