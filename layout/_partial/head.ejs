<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:description" content="<%= config.description %>">
    <meta property="og:type" content="website">
    <% if (page.keywords){ %>
        <meta name="keywords" content="<%= page.keywords %>,<%= config.keywords %>">
        <% } else if (config.keywords){ %>
        <meta name="keywords" content="<%= config.keywords %>">
    <%} %>
    <% if (page.description){ %>
        <meta name="description" content="<%= page.description %>">
        <% } else { %>
        <meta name="description" content="<%= config.description %>">
    <%} %>
    <link rel="shortcut icon" href="<%= config.root %>img/favicon.ico">

    <title>
        <% if (page.title) { %>
            <%= page.title %>
        <% } else{%>
            <%= config.SEOTitle %>
        <% } %>
    </title>

    <!-- 资源提示：提前建立连接 -->
    <link rel="preconnect" href="https://at.alicdn.com" crossorigin>
    <link rel="dns-prefetch" href="//busuanzi.ibruce.info">
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net">

    <!-- 关键 CSS：主样式同步加载 -->
    <%- css('css/aircloud.css') %>

    <!-- 非关键 CSS：延迟加载 -->
    <link rel="preload" href="<%= url_for('css/prism.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="<%= url_for('css/prism.css') %>"></noscript>
    <link rel="preload" href="<%= url_for('css/gitment.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="<%= url_for('css/gitment.css') %>"></noscript>

    <!-- iconfont 异步加载 -->
    <link rel="preload" href="https://at.alicdn.com/t/font_620856_28hi1hpxx24.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://at.alicdn.com/t/font_620856_28hi1hpxx24.css"></noscript>

    <%- partial('_partial/analytics', null, {cache: false}) %>
        
</head>
